# Copy this file to .env and replace values for local development.
# Shell environment variables take precedence over values in .env.

PONTE_BACKEND_URL=http://127.0.0.1:8080
PONTE_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# INFO (default) shows safe summaries only. DEBUG also shows LLM/MCP content,
# including medical data; HTTP bodies stay excluded and credentials stay masked.
PONTE_LOG_LEVEL=INFO
PONTE_PATIENT_ID=PAT-DEMO-001
PONTE_MOCK_USER_ID=USR-DEMO-001
PONTE_AUTHORIZATION=Bearer mock-user-token

# Optional cloud voice adapters.  The middleware transport accepts voice turns
# only when the application injects a VoiceTurnProvider; these settings are
# available to that provider and do not select a vendor by themselves.
PONTE_VOICE_STT_URL=
PONTE_VOICE_STT_API_KEY=
PONTE_VOICE_STT_MODEL=
PONTE_VOICE_AGENT_ENABLED=false
PONTE_VOICE_TTS_URL=
PONTE_VOICE_TTS_API_KEY=
PONTE_VOICE_TTS_MODEL=
PONTE_VOICE_TTS_VOICE=

# Enable the resumable agent on /api/interactions. False preserves deterministic workflows.
PONTE_AGENT_ENABLED=false
# Optional seven-turn cardiology workflow, sharing main's UI and MCP pipeline.
# off keeps the general agent/workflows; scripted is a disclosed rehearsal;
# real uses PONTE_LLM_* (or optional PONTE_DEMO_LLM_* overrides).
PONTE_DEMO_AGENT_MODE=off
# live-demo-v2 needs a fresh isolated dataset; legacy preserves existing data.
PONTE_MEDICAL_DATA_PROFILE=legacy
# OpenAI-compatible intent endpoint (flag off) or execution agent endpoint (flag on).
# Set PONTE_LLM_API_KEY to a Gemini API key from Google AI Studio or whatever platform you are using
PONTE_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# PONTE_LLM_API_URL=https://api.openai.com/v1/chat/completions
# PONTE_LLM_API_URL=https://api.deepseek.com/chat/completions
PONTE_LLM_API_KEY=
PONTE_LLM_MODEL=gemini-2.5-flash-lite
# Execution-agent timeout per completion; finite positive seconds.
PONTE_LLM_TIMEOUT_SECONDS=30
# QwenCloud agent profile (stdlib HTTP; no SDK needed). The URL includes the full path.
# PONTE_LLM_API_URL=https://maas.qwencloudapi.com/compatible-mode/v1/chat/completions
# PONTE_LLM_MODEL=qwen3.7-plus
# PONTE_LLM_ENABLE_THINKING=false
# QwenCloud thinking is disabled automatically in agent mode. Thinking-enabled
# history and streaming are not supported by this execution protocol.

# Optional, independent OpenAI-compatible Task Recovery LLM endpoint.
# Leave the URL empty to use the deterministic recovery fallback.
# This LLM receives sanitized backend/tool results, not the Intent LLM prompt.
PONTE_TASK_RECOVERY_LLM_API_URL=
PONTE_TASK_RECOVERY_LLM_API_KEY=
PONTE_TASK_RECOVERY_LLM_MODEL=gemini-2.5-flash-lite

# Docker Compose reads .env for optional overrides used by docker-compose.yml.
# All of these have safe defaults; leave them empty for the deterministic demo.
# PONTE_LOG_LEVEL=INFO
# PONTE_LLM_API_KEY=

# Optional English cloud voice; otherwise English uses browser speech.
PONTE_VOICE_TTS_VOICE_EN=
